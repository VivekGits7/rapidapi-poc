# ==================== SERVER ====================
APP_NAME="RapidAPI Auto Parts Dumper"
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# ==================== CORS ====================
FRONTEND_URL=http://localhost:3000

# ==================== RAPIDAPI (4 keys for rotation) ====================
RAPIDAPI_KEY_1=
RAPIDAPI_KEY_2=
RAPIDAPI_KEY_3=
RAPIDAPI_KEY_4=
RAPIDAPI_HOST=auto-parts-catalog.p.rapidapi.com
RAPIDAPI_BASE_URL=https://auto-parts-catalog.p.rapidapi.com
RAPIDAPI_TIMEOUT=30.0

# Locale used when fetching models/vehicles/categories
DEFAULT_LANG_ID=4
DEFAULT_COUNTRY_FILTER_ID=63

# ==================== DATABASE ====================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=autoparts
POSTGRES_USER=autoparts
POSTGRES_PASSWORD=

# ==================== DUMP TUNING ====================
DUMP_DELAY_MS=100
COOLDOWN_429_SEC=60
COOLDOWN_403_SEC=3600
COOLDOWN_5XX_SEC=10
KEY_EXHAUSTION_THRESHOLD_SEC=21600
MAX_TRANSIENT_RETRIES=3
